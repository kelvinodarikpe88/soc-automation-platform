rule gcp_service_account_key_creation {
  meta:
    author = "Kelvin Odarikpe"
    description = "New service account key created"
    severity = "HIGH"
    mitre_attack_technique = "T1098"

  events:
    $e.metadata.event_type = "GCP_IAM_SERVICE_ACCOUNT_KEY_CREATE"
    $e.principal.user.userid = $user

  match:
    $user over 1h

  condition:
    $e
}
