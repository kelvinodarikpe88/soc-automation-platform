// METADATA-START
// id: SOC-DET-009 | name: suspicious_dns_query | severity: Medium
// mitre: T1071 | nist: DE.CM-7 | iso27001: A.8.16 | soc2: CC7.2
// data_source: DNS | table: DnsEvents
// METADATA-END

DnsEvents
| where QueryName has_any (
    ".xyz",
    ".top",
    ".click",
    ".zip",
    ".mov"
)
| project TimeGenerated, Computer,
          ClientIP, Name, QueryType
